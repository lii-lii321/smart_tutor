# 前端生产构建环境变量：构建期注入（复制为 frontend/.env.production 后填写）
VITE_API_BASE=/api/v1
VITE_AMAP_KEY=
VITE_AMAP_VERSION=2.0

# 选填：Sentry 错误上报（P1-9）。留空 = 不启用
VITE_SENTRY_DSN=

# 选填：高德 Web 服务 key（REST 接口专用，与 JSAPI key 类型不同）；留空回退 VITE_AMAP_KEY
VITE_AMAP_REST_KEY=

# 高德 JSAPI 2.0 安全密钥（控制台与 JSAPI key 配对生成）：不配则底图灰屏
VITE_AMAP_SECURITY_CODE=

# 必填：无码访问根路径时兜底的默认橱窗邀请码（须为生产库真实存在的平台自有中介账号）
VITE_DEFAULT_INVITE_CODE=

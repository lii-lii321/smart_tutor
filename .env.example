# Smart Tutor Router 环境变量
# 复制为 .env 并填写实际值

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_tutor

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# 微信小程序
WX_APPID=your_appid
WX_SECRET=your_secret

# DeepSeek
DEEPSEEK_API_KEY=sk-your-api-key

# 高德地图
AMAP_API_KEY=your_amap_key

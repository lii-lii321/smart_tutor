# Smart Tutor Router 环境变量
# 复制为 .env 并填写实际值

# 生产环境推荐使用 MySQL；本地 DEV_MODE=true 时可留空并使用 SQLite。
# DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/smart_tutor?charset=utf8mb4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_tutor
AUTO_CREATE_SCHEMA=false

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72
OWNER_ACCESS_CODE=replace-with-a-long-random-value

# 开发环境才开启；生产环境必须关闭
DEV_MODE=false

# 生产前端域名，多个地址用逗号分隔
ALLOWED_ORIGINS=https://admin.example.com,https://teacher.example.com

# 微信小程序
WX_APPID=your_appid
WX_SECRET=your_secret

# DeepSeek
DEEPSEEK_API_KEY=sk-your-api-key

# 高德地图
AMAP_API_KEY=your_amap_key

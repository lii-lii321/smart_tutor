# ── 生产环境配置模板：复制为 .env.production 后逐项填写 ──
# compose 启动方式：docker compose --env-file .env.production up -d --build

# 必填：MySQL 密码（compose 会为 DB_USER 自动创建同名账号并授权）
DB_PASSWORD=
DB_USER=smart_tutor
DB_NAME=smart_tutor

# 选填：跨域白名单（逗号分隔完整 origin）。nginx 同源反代时可留空；
# 前后端分域部署时必须填，例如 https://tutor.example.com
ALLOWED_ORIGINS=

# 必填：强随机 JWT 密钥（≥32 字符，例：openssl rand -hex 32 生成）
JWT_SECRET=

# 必填：老板入口访问码（不得使用默认值 boss888）
OWNER_ACCESS_CODE=

# token 有效期（小时），默认 72
JWT_EXPIRE_HOURS=72

# 必填：DeepSeek API Key（AI 订单解析）
DEEPSEEK_API_KEY=

# 必填：高德地图 Key（地理编码；前端 key 在 frontend/.env.production 配置）
AMAP_API_KEY=

# 选填：微信小程序（不启用微信登录则留空）
WX_APPID=
WX_SECRET=

# Web 对外端口
WEB_PORT=80

# 限流
MAX_PARSE_PER_MINUTE=20
MAX_LOGIN_PER_MINUTE=10
ORDER_EXPIRE_HOURS=72

# 选填：Sentry 错误上报（P1-9）。留空 = 不启用；在 sentry.io 建项目后粘贴 DSN
SENTRY_DSN=
